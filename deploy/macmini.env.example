# Mac mini single-machine deployment (Docker Compose)
#
# 1) Copy to .env at repo root (or export these variables)
# 2) Set HOST_DATA_DIR to a location with enough free space (>= 200GB recommended)
# 3) Start with deploy/macmini_one_click.sh

# Host data root (bind mounts for mongodb/redis/uploads)
# Note: if you use an external drive under /Volumes, ensure Docker Desktop "File Sharing" includes it.
HOST_DATA_DIR=/Users/yourname/ClinicalMatchData

# JWT Secret for Authentication (change in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB (docker-compose will use the mongodb service internally)
MONGODB_URI=mongodb://mongodb:27017/clinicalmatch

# Server
PORT=5001
APP_MODE=production

# Privacy defaults for a local appliance-style deployment
# - redact: send de-identified text (recommended if using 3rd-party LLMs)
# - full: still applies identifier redaction in code, but keeps more clinical content
LLM_PHI_MODE=redact
MATCH_HISTORY_MAX=1
ALLOW_OCR_MOCK=false
CLOUD_BACKUP_ENABLED=false
FILE_RETENTION_DEFAULT=3years

# Strict mode: disable implicit fallbacks and require real OCR+LLM to be available.
STRICT_MODE=true
REQUIRE_LLM=true
ALLOW_PARSING_FALLBACK=false
ALLOW_OCR_TESSERACT_FALLBACK=false
OCR_REQUIRE_CREDENTIALS=true

# OCR service (docker-compose internal URL)
PYTHON_OCR_URL=http://ocr-service:5002

# CORS (browser will normally call via frontend /api proxy, but keep a safe allowlist)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Trial data
TRIAL_CSV_PATH=./data/clinical_trials/liver_cancer_trials.csv
TRIALS_INMEMORY_TTL_MS=300000
ALLOW_TRIAL_REFRESH=false

# Optional external LLM (keep blank by default)
OPENAI_API_KEY=
baseURL=https://api.moonshot.cn/v1
