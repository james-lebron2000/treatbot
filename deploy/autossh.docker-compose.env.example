# Example config for docker-compose + relay reverse tunnels
#
# Usage:
#   cp deploy/autossh.docker-compose.env.example deploy/autossh.env
#   # edit AUTOSSH_REMOTE_USER/SSH_IDENTITY_FILE
#   bash deploy/autossh_manual.sh
#
# IMPORTANT:
# - LOCAL_* ports must match your host-published ports.
# - If you start docker-compose with `docker-compose.relay.yml`, set LOCAL_OCR_PORT/LOCAL_MEDICAL_PORT accordingly.

AUTOSSH_REMOTE_USER=relay
AUTOSSH_REMOTE_HOST=167.179.111.87
AUTOSSH_SSH_PORT=22

# Local host ports (your machine)
LOCAL_FRONTEND_PORT=3002
LOCAL_MEDICAL_PORT=5002
LOCAL_OCR_PORT=5003

# Relay ports (relay machine loopback, consumed by Nginx)
REMOTE_FRONTEND_PORT=8300
REMOTE_MEDICAL_PORT=8502
REMOTE_OCR_PORT=8501

SSH_IDENTITY_FILE=%h/.ssh/id_rsa_clinical_trial

