# Environment variables consumed by autossh.service
# Copy to autossh.env and update values before enabling the service.

AUTOSSH_REMOTE_USER=root
AUTOSSH_REMOTE_HOST=167.179.111.87
AUTOSSH_SSH_PORT=22
AUTOSSH_CONTROL_PATH=%h/.ssh/cm-%r@%h:%p

# Exposed local services
LOCAL_FRONTEND_PORT=3000
LOCAL_OCR_PORT=5001
LOCAL_MEDICAL_PORT=5002
LOCAL_MATCH_PORT=5003

# Remote ports on relay
REMOTE_FRONTEND_PORT=8300
REMOTE_OCR_PORT=8501
REMOTE_MEDICAL_PORT=8502
REMOTE_MATCH_PORT=8503

# Path to SSH identity file
SSH_IDENTITY_FILE=%h/.ssh/id_rsa_clinical_trial
