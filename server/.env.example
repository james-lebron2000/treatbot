# Copy this file to `.env` and fill values for production/development

# Server
PORT=5001
MONGODB_URI=mongodb://localhost:27017/clinicalmatch
JWT_SECRET=change-me-to-a-random-secret
APP_MODE=production
STRICT_MODE=false
REQUIRE_LLM=false
ALLOW_PARSING_FALLBACK=true
ALLOW_OCR_TESSERACT_FALLBACK=true

# Redis (optional; required for production async processing)
# Provide either REDIS_URL or host/port credentials. Leave blank to use in-memory mock mode.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
MATCH_CACHE_TTL=600
TRIALS_CACHE_TTL=3600
TRIALS_INMEMORY_TTL_MS=300000
STEPWISE_MAX_ATTEMPTS=3
STEPWISE_BACKOFF_MS=5000
STEPWISE_CONCURRENCY=2
OCR_QUEUE_MAX_ATTEMPTS=3
OCR_QUEUE_BACKOFF_MS=3000
OCR_QUEUE_CONCURRENCY=2
TRIALS_JSON_PATH=

# LLM (Moonshot Kimi)
OPENAI_API_KEY=your-moonshot-api-key
baseURL=https://api.moonshot.cn/v1

# LLM privacy mode for OCR medical text:
# - full: allow LLM usage; outbound text is de-identified (identifiers redacted)
# - redact: more aggressive de-identification (may reduce matching quality)
# - disallow: disable any LLM calls that would send medical text/data to third-party models
LLM_PHI_MODE=full
COMPLIANCE_SECURITY_AGREEMENT_VERSION=2025-12-18
MATCH_HISTORY_MAX=50

# LLM match output cap
LLM_MATCH_MAX_RESULTS=15

# Python OCR microservice (optional)
PYTHON_OCR_URL=http://localhost:5002
# Allow mock OCR fallback (default: false; enable only when you explicitly want it)
ALLOW_OCR_MOCK=false

# Trial data CSV (absolute path or relative to project root)
TRIAL_CSV_PATH=./liver_cancer_trials.csv

# Match result cap returned by APIs (classic/enhanced)
MATCH_MAX_RESULTS=50

# Enable /api/trials/refresh (default false)
ALLOW_TRIAL_REFRESH=false

# Phone OTP login
SMS_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_FAILED_ATTEMPTS=5

# Alibaba Cloud OCR (optional; used for health checks or direct integration)
ALIBABA_ACCESS_KEY_ID=your_access_key_id
ALIBABA_ACCESS_KEY_SECRET=your_access_key_secret
ALIBABA_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ALIBABA_OCR_REGION=cn-hangzhou

# Alibaba Cloud OSS (for cloud backup)
ALIBABA_OSS_REGION=oss-cn-hangzhou
ALIBABA_OSS_BUCKET=clinical-match-backups

# File Storage Configuration
STORAGE_BASE_PATH=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

# Upload limits (multer)
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_FILES=10

# ============================================
# Phase 1 Refactoring - Feature Flags
# ============================================

# Master switch for refactored services (default: false for safety)
FEATURE_USE_REFACTORED_SERVICES=false

# Percentage rollout (0-100, only applies if master switch is false)
# Allows gradual rollout to subset of users
FEATURE_USE_REFACTORED_SERVICES_PERCENTAGE=0

# Enable new clinical entity schemas (default: false)
FEATURE_ENABLE_CLINICAL_ENTITIES=false
FEATURE_ENABLE_CLINICAL_ENTITIES_PERCENTAGE=0

# Enable hybrid matching (default: true, already in production)
FEATURE_ENABLE_HYBRID_MATCHING=true

# Enable batch streaming (default: true, already in production)
FEATURE_ENABLE_BATCH_STREAMING=true

# Enable match history (default: true, already in production)
FEATURE_ENABLE_MATCH_HISTORY=true

# Enable stepwise extraction (default: true, already in production)
FEATURE_ENABLE_STEPWISE_EXTRACTION=true

# Enable strict validation (default: false for backward compatibility)
FEATURE_STRICT_VALIDATION=false

# ============================================
# Phase 2 Algorithm Enhancement - Feature Flags
# ============================================

# Enable Phase 2 matching engine with ML + ontology (default: false)
FEATURE_PHASE2_MATCH_ENGINE=false

# Percentage rollout for Phase 2 (0-100, only applies if Phase 2 is enabled)
PHASE2_TRAFFIC_PERCENTAGE=10

# Ontology service configuration
ONTOLOGY_CACHE_L1_SIZE=10000
ONTOLOGY_CACHE_L1_TTL=3600
ONTOLOGY_CACHE_L2_TTL=86400
ONTOLOGY_CACHE_L3_UPDATE_INTERVAL=2592000

# ML model configuration
ML_MODEL_VERSION=v1
ML_ENSEMBLE_WEIGHTS_LOGISTIC=0.2
ML_ENSEMBLE_WEIGHTS_XGBOOST=0.4
ML_ENSEMBLE_WEIGHTS_NN=0.4

# Hybrid fusion configuration
HYBRID_FUSION_ML_WEIGHT=0.6
HYBRID_FUSION_RULE_WEIGHT=0.4
HYBRID_MIN_SCORE=40
HYBRID_CONFIDENCE_THRESHOLD=0.5

# Feedback pipeline configuration
FEEDBACK_RETRAINING_THRESHOLD=500
FEEDBACK_RETRAINING_SCHEDULE=monthly
