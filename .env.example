# Database Configuration
MONGODB_URI=mongodb://localhost:27017/clinicalmatch

# JWT Secret for Authentication
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# OpenAI-Compatible API Configuration (Moonshot/Kimi)
OPENAI_API_KEY=your_moonshot_api_key_here
baseURL=https://api.moonshot.cn/v1

# LLM privacy mode for OCR medical text:
# - full: allow LLM usage; outbound text is de-identified (identifiers redacted)
# - redact: more aggressive de-identification (may reduce matching quality)
# - disallow: disable any LLM calls that would send medical text/data to third-party models
LLM_PHI_MODE=full
COMPLIANCE_SECURITY_AGREEMENT_VERSION=2025-12-18
MATCH_HISTORY_MAX=50

# Strict runtime behavior:
# - STRICT_MODE=true: disallow implicit fallbacks; require OCR + LLM to work
# - REQUIRE_LLM=true: require LLM configuration even if not in strict mode
STRICT_MODE=false
REQUIRE_LLM=false
ALLOW_PARSING_FALLBACK=true
ALLOW_OCR_TESSERACT_FALLBACK=true

# LLM match output cap (defensive; controller may also cap overall results)
LLM_MATCH_MAX_RESULTS=15

# Alibaba Cloud OCR Configuration
ALIBABA_ACCESS_KEY_ID=your_alibaba_access_key_id_here
ALIBABA_ACCESS_KEY_SECRET=your_alibaba_access_key_secret_here
ALIBABA_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ALIBABA_OCR_REGION=cn-hangzhou

# Service URLs
PYTHON_OCR_URL=http://localhost:5002
OCR_REQUIRE_CREDENTIALS=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_POINTS=120
RATE_LIMIT_DURATION=60
RATE_LIMIT_BLOCK_DURATION=0

# Upload limits (multer)
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_FILES=10

# Reverse proxy settings (important for correct req.ip / rate limiting behind Nginx/Cloudflare)
# TRUST_PROXY=1

# Prometheus metrics protection
# In production, /api/metrics is disabled unless METRICS_TOKEN is set.
# Scrape with: Authorization: Bearer $METRICS_TOKEN
# METRICS_TOKEN=change-me

# Development User Configuration (optional)
DEV_USER_EMAIL=test@example.com
DEV_USER_PASSWORD=password123
DEV_USER_NAME=Test User

# Server Configuration
PORT=5001

# Match result cap returned by APIs (classic/enhanced)
MATCH_MAX_RESULTS=50

# Data Files
# TRIAL_CSV_PATH=./data/clinical_trials/liver_cancer_trials.csv

# Trial cache refresh behavior (helps “realtime recruiting status” when source file updates)
TRIALS_INMEMORY_TTL_MS=300000

# Enable /api/trials/refresh (default false)
ALLOW_TRIAL_REFRESH=false

# ============================================
# Phase 2 Algorithm Enhancement - Feature Flags
# ============================================

# Enable Phase 2 matching engine with ML + ontology (default: false)
FEATURE_PHASE2_MATCH_ENGINE=false

# Percentage rollout for Phase 2 (0-100)
PHASE2_TRAFFIC_PERCENTAGE=10
