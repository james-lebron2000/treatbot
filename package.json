{
  "name": "clinical-match",
  "version": "1.0.0",
  "description": "Clinical trial matching platform demo",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "ocr": "./python_ocr_service/.venv/bin/python python_ocr_service/ocr_server.py",
    "dev:all": "concurrently \"npm run ocr\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "test": "jest",
    "test:e2e:trace": "jest server/test/request-id.test.js --runInBand",
    "qa:gate": "npm -C client run lint && npm -C client run build && npm test",
    "e2e:serve": "concurrently -k -s first \"cd server && npm start\" \"cd client && NEXT_PUBLIC_API_BASE_URL=/api npm run dev -- -p 3000\"",
    "test:e2e": "start-server-and-test \"npm run e2e:serve\" http://localhost:3000 \"playwright test\"",
    "start:prod": "npm run build && concurrently \"cd server && npm start\" \"cd client && npm start\"",
    "setup:python": "./scripts/setup_python_venv.sh",
    "db:seed": "cd server && npm run setup",
    "bootstrap": "npm run install-all && npm run setup:python && npm run db:seed && npm run dev:all"
  },
  "keywords": [
    "clinical-trials",
    "healthcare",
    "matching"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^8.2.2",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^11.0.1",
    "start-server-and-test": "^2.1.3",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.3",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "msw": "^2.11.5",
    "zod": "^4.1.12"
  }
}
