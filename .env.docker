# Docker Environment Configuration
# Copy this file to .env and update with your actual values

# Public frontend port on the host (docker-compose.yml maps ${FRONTEND_PORT}:3000)
FRONTEND_PORT=3055

# MongoDB Configuration (Docker internal)
MONGODB_URI=mongodb://mongodb:27017/clinicalmatch

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# OpenAI-Compatible API Configuration (Moonshot/Kimi)
OPENAI_API_KEY=your_moonshot_api_key_here
baseURL=https://api.moonshot.cn/v1

# LLM privacy mode:
# - full: allow LLM usage; outbound text is de-identified (identifiers redacted)
# - redact: more aggressive de-identification (may reduce matching quality)
# - disallow: disable any LLM calls that would send medical text/data to third-party models
LLM_PHI_MODE=full
COMPLIANCE_SECURITY_AGREEMENT_VERSION=2025-12-18
MATCH_HISTORY_MAX=50

# Alibaba Cloud OCR Configuration
ALIBABA_ACCESS_KEY_ID=your_alibaba_access_key_id_here
ALIBABA_ACCESS_KEY_SECRET=your_alibaba_access_key_secret_here
ALIBABA_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ALIBABA_OCR_REGION=cn-hangzhou

# Service URLs (Docker internal)
PYTHON_OCR_URL=http://ocr-service:5002

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOW_CREDENTIALS=true

# Server Configuration
PORT=5001

# Development Configuration
APP_MODE=production

# Rate Limiting
RATE_LIMIT_POINTS=120
RATE_LIMIT_DURATION=60
RATE_LIMIT_BLOCK_DURATION=0

# Reverse proxy settings (important for correct req.ip / rate limiting behind Nginx/Cloudflare)
# TRUST_PROXY=1

# Protect Prometheus metrics endpoint (/api/metrics) in production.
# Scrape with: Authorization: Bearer $METRICS_TOKEN
# METRICS_TOKEN=change-me

# Health endpoint details protection
# /api/health returns a minimal payload by default in production.
# To access detailed dependency/config health, set HEALTH_TOKEN and request with:
# Authorization: Bearer $HEALTH_TOKEN
# HEALTH_TOKEN=change-me
